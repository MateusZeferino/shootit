# Valores publicos encontrados em Supabase > Connect.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Segredo exclusivo do servidor. Nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2: credenciais S3 exclusivas do servidor; bucket privado.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=shootit-photos
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
